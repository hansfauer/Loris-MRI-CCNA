# to source the MINC toolkit
source /opt/minc/1.9.18/minc-toolkit-config.sh
umask 0002

# export PATH, PERL5LIB, TMPDIR and LORIS_CONFIG variables
export PATH=/opt/hansCCNA/bin/mri:/opt/hansCCNA/bin/mri/uploadNeuroDB:/opt/hansCCNA/bin/mri/uploadNeuroDB/bin:/opt/hansCCNA/bin/mri/dicom-archive:/opt/hansCCNA/bin/mri/python:/opt/hansCCNA/bin/mri/tools:/opt/hansCCNA/bin/mri/python/react-series-data-viewer:/opt/minc/1.9.18/bin:$PATH
export PERL5LIB=/opt/hansCCNA/bin/mri/uploadNeuroDB:/opt/hansCCNA/bin/mri/dicom-archive:$PERL5LIB
export TMPDIR=/data/not_backed_up/
export LORIS_CONFIG=/opt/hansCCNA/bin/mri/dicom-archive

# for the Python scripts
export LORIS_MRI=/opt/hansCCNA/bin/mri
export PYTHONPATH=$PYTHONPATH:/opt/hansCCNA/bin/mri/python:/opt/hansCCNA/bin/mri/python/react-series-data-viewer
source /opt/hansCCNA/bin/mri/python_virtualenvs/loris-mri-python/bin/activate

# for the defacing scripts
export BEASTLIB=/opt/minc/1.9.18/../share/beast-library-1.1
export MNI_MODELS=/opt/minc/1.9.18/../share/icbm152_model_09c